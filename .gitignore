# Python bytecode, test and tool caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local environments and secrets
.env
.env.*
!.env.example
.venv/
.venv_*/
venv/
env/
conda-env/

# Notebooks and editor files
.ipynb_checkpoints/
**/.ipynb_checkpoints/
.vscode/
.idea/
*.swp
*.swo

# Operating-system files
.DS_Store
Thumbs.db

# Logs and temporary files
*.log
*.tmp
*.bak
*.orig

# Raw benchmark data: keep only documentation/placeholders.
data/raw/**
!data/raw/README.md
!data/raw/.gitkeep

# Materialised pair tables, tensors and ESM-2 caches; compact pair-table
# provenance sidecars may be reviewed/versioned separately.
data/processed/**
!data/processed/README.md
!data/processed/.gitkeep
!data/processed/*.metadata.json
**/esm2_cache/**
**/esm_cache/**
**/*esm2*embedding*.pt
**/*residue*embedding*.pt
caches/esm2/**
**/esm2_embeddings/**

# Full pair-membership manifests are local/Drive; compact metadata is versionable.
data/splits/**
!data/splits/README.md
!data/splits/.gitkeep
!data/splits/manifests/
!data/splits/manifests/.gitkeep
!data/splits/manifests/*.metadata.json
!data/splits/metadata/
!data/splits/metadata/.gitkeep
!data/splits/metadata/*.json

# Checkpoints and training state.
models/**
!models/README.md
!models/.gitkeep
checkpoints/**
*.ckpt
*.pth
*.onnx

# Full per-pair predictions are regenerated; allow explicit compact summaries.
results/predictions/**
!results/predictions/README.md
!results/predictions/.gitkeep
!results/predictions/*_summary.csv
!results/predictions/*_summary.json

# Large or intermediate screening artefacts; compact ranked summaries remain trackable.
results/screening/raw/**
results/screening/cache/**
results/screening/*_all_pairs.csv
results/screening/*_full_predictions.csv
results/screening/*_predictions_full.csv
results/screening/aml_approved_drug_pairs.csv
results/screening/*pair_comparison*.csv
results/screening/*pair_rank_comparison*.csv
results/screening/*pair_predictions*.csv
results/screening/*screening_pairs*.csv
results/screening/*_embeddings.pt

# Approved-drug source/preparation tables and full Cartesian AML caches.
# Keep data/aml/README.md and the established aml_targets.csv versionable.
data/aml/approved_drugs_raw.*
data/aml/approved_drugs_metadata.csv
data/aml/approved_drugs_prepared.csv
data/aml/approved_drug_rejections.csv
data/aml/aml_targets_prepared*.csv
data/aml/*approved*screening_pairs*.csv
data/aml/*approved*predictions_full*.csv
data/aml/*all_pairs*.csv
data/aml/*embedding*.pt
results/screening/approved_drug_rejections.csv

# Runtime/workspace copies used by Colab or Drive synchronisation.
dti_workspace/
drive_mount/
artifacts/
